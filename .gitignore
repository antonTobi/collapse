# Build directories
dist/
.parcel-cache/

# Dependencies
node_modules/

# Package management files
package-lock.json

# Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Trained network weights are build artifacts, not source: `ptrain.js` and
# `grow.js` regenerate them, and the big ones are tens of megabytes each.
# bot/weights/big-td.bin (12 MB) is committed so the spectator and the
# reproduction commands in bot/README.md work from a fresh clone.
# Allow-list rather than deny-list: every new training run produces another
# large .bin, and listing them one by one gets one of them wrong eventually.
bot/weights/*.bin
bot/weights/*.bins
!bot/weights/big-td.bin
!bot/weights/c_base.bin
!bot/weights/td1.bin
!bot/weights/td1_ckpt.bin
!bot/weights/td_probe.bin
!bot/weights/tdsym.bin
!bot/weights/tdsym2.bin
!bot/weights/tdsym3.bin
bot/data/starts*.bin
